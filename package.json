{
  "name": "@ivmartel/dwv-vue",
  "version": "0.11.0-beta.0",
  "description": "Medical image viewer component for Vue.js, using DWV (DICOM Web Viewer).",
  "author": "ivmartel",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivmartel/dwv-vue.git"
  },
  "homepage": "https://github.com/ivmartel/dwv-vue",
  "bugs": "https://github.com/ivmartel/dwv-vue/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dicom",
    "medical",
    "imaging",
    "viewer",
    "vue",
    "dwv"
  ],
  "type": "module",
  "module": "./dist/dwv-vue-lib/dwv-vue.js",
  "types": "./dist/dwv-vue-lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dwv-vue-lib/types/src/index.d.ts",
      "default": "./dist/dwv-vue-lib/dwv-vue.js"
    },
    "./style.css": "./dist/dwv-vue-lib/style.css",
    "./vite-plugin": {
      "types": "./dist/dwv-vue-lib/types/plugins/dwvWorkers.d.ts",
      "default": "./plugins/dwvWorkers.js"
    }
  },
  "files": [
    "dist/dwv-vue-lib/**",
    "plugins/dwvWorkers.js"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-app-trunk": "vite build --mode development --base /dwv-vue/demo/trunk",
    "build-app-stable": "vite build --mode production --base /dwv-vue/demo/stable",
    "build-lib": "vite build --config vite.lib.config.js && yarn run build-types",
    "build-types": "vue-tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test": "vitest",
    "test-ci": "vitest run --coverage",
    "lint": "eslint src/**/*.{js,vue} demo/*.{js,vue} plugins/*.js",
    "prepack": "yarn run build-lib"
  },
  "dependencies": {
    "dwv": "0.36.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.13",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14",
    "vuetify": "^4.3.3"
  },
  "packageManager": "yarn@4.18.0"
}
