{
  "name": "dwv-vue",
  "version": "0.11.0-beta.0",
  "description": "Medical viewer using DWV (DICOM Web Viewer) and Vue.js.",
  "author": "ivmartel",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivmartel/dwv-vue.git"
  },
  "homepage": "https://github.com/ivmartel/dwv-vue",
  "bugs": "https://github.com/ivmartel/dwv-vue/issues",
  "keywords": [
    "dicom",
    "medical",
    "imaging",
    "viewer",
    "vue",
    "dwv"
  ],
  "type": "module",
  "module": "./dist/dwv-vue-lib/dwv-vue.js",
  "exports": {
    ".": "./dist/dwv-vue-lib/dwv-vue.js",
    "./style.css": "./dist/dwv-vue-lib/style.css"
  },
  "files": [
    "dist/dwv-vue-lib/**"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-app-trunk": "vite build --mode development --base /dwv-vue/demo/trunk",
    "build-app-stable": "vite build --mode production --base /dwv-vue/demo/stable",
    "build-lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "test": "vitest",
    "test-ci": "vitest run --coverage",
    "lint": "eslint src/**/*.{js,vue}",
    "prepack": "yarn run build-lib"
  },
  "dependencies": {
    "dwv": "0.36.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "canvas": "^3.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vuetify": "^4.1.3"
  },
  "packageManager": "yarn@4.18.0"
}
